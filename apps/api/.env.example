SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORT=3000

# Email sign-in codes are sent with Resend (https://resend.com/api-keys).
# Without a verified domain, Resend only delivers from onboarding@resend.dev to your own Resend account email.
RESEND_API_KEY=your-resend-key
RESEND_FROM=zyvault <onboarding@resend.dev>

# Bank logo tiles are hosted on Cloudinary (only the cloud name is sent to the app)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AI spend parser. LLM_PROVIDER is tried first, then the others in the order google, groq, openrouter (only those with a key).
LLM_PROVIDER=google
GOOGLE_AI_API_KEY=your-google-ai-studio-key
GROQ_API_KEY=your-groq-key
OPENROUTER_API_KEY=your-openrouter-key
# Optional model overrides. Defaults: gemini-flash-lite-latest (also reads bill photos); Groq parser gpt-oss-120b then qwen3.8-27b; OpenRouter free Gemma 4 / Nemotron.
# The chatbot always calls openai/gpt-oss-20b. Do not set GROQ_MODEL to that id; the parser skips it so the two features do not share one daily token cap.
GOOGLE_AI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
# Optional: only asked when the LLM gives no usable category (free HF accounts have no inference credit)
HF_TOKEN=your-hugging-face-token

# Push notifications (Firebase Cloud Messaging). Path to the service-account JSON from
# Firebase console > Project settings > Service accounts > Generate new private key. Keep it out of git.
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
